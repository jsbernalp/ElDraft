<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Config inyectada por Config/Debug.xcconfig, leída por AppConfig.swift. -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>WS_BASE_URL</key>
	<string>$(WS_BASE_URL)</string>
	<key>MAPS_API_KEY_IOS</key>
	<string>$(MAPS_API_KEY_IOS)</string>
	<key>LEGAL_BASE_URL</key>
	<string>$(LEGAL_BASE_URL)</string>

	<!-- Solo Debug: permite http:// hacia localhost para el backend local.
	     El binario de Release no lleva esta excepción ni siquiera desactivada. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- REVERSED_CLIENT_ID de GoogleService-Info-Debug.plist: URL scheme por
	     el que el sistema devuelve el control a la app tras "Continuar con
	     Google" (lo usa GoogleSignIn-iOS, no Firebase Auth). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!-- Fase 3 (Buscar Cupo): CoreLocation exige este texto para mostrar el
	     diálogo de permiso de ubicación. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Usamos tu ubicación para mostrarte los partidos abiertos más cerca de ti. Sin este permiso no podemos buscar cupos en tu zona.</string>

	<!-- Fase 6 (Asistencia): AVFoundation exige este texto para mostrar el
	     diálogo de permiso de cámara al escanear el QR de asistencia. -->
	<key>NSCameraUsageDescription</key>
	<string>Necesitamos la cámara para escanear el código QR y registrar tu asistencia al partido.</string>

	<!-- Lo pide la doc de Maps SDK for iOS para que el botón "Abrir en Google
	     Maps" del logo del mapa pueda comprobar si esas apps están instaladas. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>googlechromes</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ElDraft" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- La app es siempre clara: fondo de ventana blanco para que detrás del
             status bar (edge-to-edge) se vea blanco y los íconos oscuros sean
             legibles. También evita el flash oscuro al arrancar.
             Los colores de status/navigation bar los maneja enableEdgeToEdge(). -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Tema del splash nativo del sistema (API SplashScreen). Es lo que Android
         pinta al instante, antes de que arranque Compose. Solo pinta el fondo
         oscuro de marca (sin ícono): el ícono lo muestra el splash de Compose
         enseguida, evitando el recorte circular del sistema y el flash blanco.
         installSplashScreen() en MainActivity hace el handoff hacia Theme.ElDraft. -->
    <style name="Theme.ElDraft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.ElDraft</item>
    </style>
</resources>
